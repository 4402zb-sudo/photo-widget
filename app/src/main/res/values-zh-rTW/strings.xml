    <!-- Widget settings -->
    <string name="widget_settings_title">小工具設定</string>
    <string name="widget_settings_description">隨時套用到所有小工具的偏好設定</string>
    <string name="widget_settings_explanation">和小工具預設值不同，這些設定會隨時套用到你所有的小工具。變更可能會立即生效，也可能要等到小工具下次更新時才生效，也就是你操作它或排程時間到的時候。</string>
    <string name="widget_settings_crossfade">照片淡入淡出</string>
    <string name="widget_settings_crossfade_description">小工具切換到下一張照片時以淡入淡出呈現。裝置關閉動畫效果時無效。</string>
    <string name="widget_settings_folder_sync_interval">資料夾同步間隔</string>
    <string name="widget_settings_folder_sync_interval_description">多久檢查一次你加入小工具的資料夾，看看照片有沒有新增、移除或變更。\n\n檢查越頻繁，小工具更新得越快，但也越耗電。</string>

